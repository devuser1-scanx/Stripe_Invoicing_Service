APP_NAME=ScanX Billing Service
APP_VERSION=0.1.0
ENVIRONMENT=local
LOG_LEVEL=INFO

INSTANCE_CONNECTION_NAME=vernal-maker-473121-k4:us-central1:scanx-postgres-db
DB_USER=postgres
DB_PASSWORD=replace-me
